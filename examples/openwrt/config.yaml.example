# /etc/yandex-sync/config.yaml — пример для OpenWrt
token: "ваш_oauth_токен"
sync_frequency: "10m"

# Кэш и логи переопределяются init-скриптом через env:
#   CACHE_PATH=/etc/yandex-sync/cache.json
#   LOG_DIR=/etc/yandex-sync/logs
cache_enabled: true

# Логи сессий: off | simple | extended
log_mode: "simple"

# Сервер статуса: http://<router>:9277/healthz и /stats
http_enabled: true
http_port: 9277

folders:
  - local: "/mnt/sdcard/documents"
    remote: "disk:/backup/documents"
    sync_mode: "bidirectional"   # upload | download | bidirectional
    delete_mode: "none"          # none | local | remote | both
    # Исключения по маскам через '|': без '/' — совпадение с именем файла или
    # папки на любой глубине; с '/' — с полным относительным путём
    exclude_pattern: "node_modules|cache_*|*.tmp|*.part"
