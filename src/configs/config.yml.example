token: "api_key"                    # или env YANDEX_TOKEN
sync_frequency: "5m"                # 5 minutes; или env SYNC_FREQUENCY

cache_enabled: true                 # кэш MD5 + история синхронизации (нужен для распространения удалений)
# cache_path: "~/.cache/yandex-sync/cache.json"   # или env CACHE_PATH

log_mode: "extended"                # off | simple | extended (расширенный лог пишется в log_dir/detail/)
# log_dir: "~/.cache/yandex-sync/logs"            # или env LOG_DIR
# log_max_files: 10

http_enabled: true                  # сервер статуса: /healthz, /stats
http_port: 9277                     # или env HTTP_PORT

folders:
  - local: "/tmp/file1"
    remote: "disk:/backup/file1"
    sync_mode: "bidirectional"  # upload, download, or bidirectional
    delete_mode: "both"  # none, local, remote, or both
    exclude_pattern: "node_modules|*.tmp"  # маски через '|' 
  - local: "/tmp/file2"
    remote: "disk:/backup/file2"
    sync_mode: "upload"  # upload, download, or bidirectional
    delete_mode: "none"  # none, local, remote, or both
